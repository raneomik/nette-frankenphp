{layout tRoot('@layout.latte')}

{* no page of its own to link to in another language *}
{block seo}<meta name="robots" content="noindex">{/block}
{block localeSwitch}{/block}

{block content}
    <div class="hero py-20">
        <div class="hero-content text-center">
            <div class="max-w-md space-y-4 [&_h1]:text-4xl [&_h1]:font-extrabold [&_small]:opacity-60">
                {include error}
                <p><a n:href=":Home:" class="btn btn-primary">{_'app.backHome'}</a></p>
            </div>
        </div>
    </div>
{/block}
