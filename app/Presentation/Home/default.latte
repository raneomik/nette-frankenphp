{block content}
    <div class="hero">
        <div class="hero-content text-center">
            <div class="max-w-md">
                <p class="m-3">
                    A Nette app running on FrankenPHP, with real-time updates through Mercure.
                </p>
                <p class="m-3">
                    Learn more below
                </p>
                <div class="flex flex-wrap justify-center gap-4 py-10 sm:gap-10">
                    <a href="//nette.org" target="_blank" class="tooltip tooltip-bottom" data-tip="Nette">
                        <div class="hover-3d">
                            <!-- content -->
                            <figure class="w-20 rounded-4xl sm:w-25">
                                <img n:asset="img:nette" alt="Nette logo"/>
                            </figure>
                            <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
                        </div>
                    </a>
                    <a href="//frankenphp.dev" target="_blank" class="tooltip tooltip-bottom" data-tip="FrankenPHP">
                        <div class="hover-3d">
                            <!-- content -->
                            <figure class="w-20 rounded-4xl sm:w-25">
                                <img n:asset="img:frankenphp" alt="FrankenPHP logo"/>
                            </figure>
                            <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
                        </div>
                    </a>
                    <a href="//mercure.rocks" target="_blank" class="tooltip tooltip-bottom" data-tip="Mercure">
                        <div class="hover-3d">
                            <!-- content -->
                            <figure class="w-20 rounded-4xl sm:w-25">
                                <img n:asset="img:mercure" alt="Mercure logo"/>
                            </figure>
                            <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
                        </div>
                    </a>
                </div>

                <p class="mt-5">
                    Powered by the
                    <a href="//github.com/raneomik/nette-mercure"
                       target="_blank"
                       class="inline-flex items-center gap-1 text-primary underline hover:no-underline"
                    >
                        nette-mercure
                        {include tRoot('_icon/github.svg.latte'), class: 'size-5'}
                    </a> and
                    <a href="//github.com/raneomik/nette-pwa"
                       target="_blank"
                       class="inline-flex items-center gap-1 text-primary underline hover:no-underline"
                    >
                        nette-pwa
                        {include tRoot('_icon/github.svg.latte'), class: 'size-5'}
                    </a>
                    <br>
                    (and <a href="//github.com/raneomik/tracy-dark-mode"
                       target="_blank"
                       class="inline-flex items-center gap-1 text-primary underline hover:no-underline"
                    >
                        tracy-dark-mode
                        {include tRoot('_icon/github.svg.latte'), class: 'size-5'}
                    </a>
                    in dev/debug mode) extensions
                </p>
            </div>
        </div>
    </div>

    <div class="flex justify-center text-center m-10">
        <div class="grid grid-cols-1 gap-4 max-w-100">
            <a n:href="RockPaperScissors:Base:default" class="btn btn-primary btn-lg">
                👊 Play Rock Paper Scissors 🖖
            </a>
            <p class="mt-4 text-xs tracking-widest uppercase opacity-60">Live demos</p>
            <a n:href="Home:default" target="_blank" class="btn btn-ghost">
                Open new tab to watch live updates 🔗
            </a>

            <a n:href="dispatch!" class="btn btn-ghost ajax">
                Send a toast to every tab
            </a>
            <a n:href="dispatch! 'turbo'" class="btn btn-ghost ajax">
                Send a toast with Turbo Streams
            </a>
        </div>
    </div>
{/block}

{block turboLink}
    <div
        data-mercure-url="{mercure('test-topic')}"
        data-mercure="test-topic"
        class="toast toast-start">
    </div>
    <div class="flex justify-center" data-turbo-listen="turbo-test-topic">
        <div id="toast-container" class="toast toast-end">
        </div>
    </div>
{/block}
