{block content}
    <div class="hero">
        <div class="hero-content text-center">
            <div class="max-w-md cursor-pointer">
                <div class="space-x-5">
                    <a href="//nette.org" target="_blank">
                        <div class="hover-3d py-6">
                            <!-- content -->
                            <figure class="w-32 rounded-4xl">
                                <img n:asset="img:nette" alt="nette 3D"/>
                            </figure>

                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    </a>
                    <a href="//frankenphp.dev" target="_blank">
                        <div class="hover-3d">
                            <!-- content -->
                            <figure class="w-32 rounded-4xl">
                                <img n:asset="img:frankenphp" alt="frankenphp 3D"/>
                            </figure>

                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    </a>
                    <a href="//mercure.rocks" target="_blank">
                        <div class="hover-3d">
                            <!-- content -->
                            <figure class="w-32 rounded-4xl">
                                <img n:asset="img:mercure" alt="mercure 3D"/>
                            </figure>

                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>


    <div class="flex justify-center text-center m-20">
        <div class="grid grid-cols-1 gap-4 max-w-100">

            <a n:href="dispatch!" class="btn ajax">
                👉 Click me for mercure toast 👈
            </a>
            <a n:href="dispatch! 'turbo'" class="btn ajax">
                👉 Click me for turbo toast 👈
            </a>
            <a n:href="Home:default" target="_blank" class="btn">
                new tab to see interaction 🔗
            </a>
        </div>
    </div>

    <div
        data-mercure-url="{mercure('test-topic', hub: 'legacy', options: [addJwt => true])}"
        data-mercure="test-topic"
        class="toast toast-start">
    </div>
    <div class="flex justify-center" data-turbo-listen="turbo-test-topic">
        <div id="stream-container" class="toast toast-end">
        </div>
    </div>
{/block}
