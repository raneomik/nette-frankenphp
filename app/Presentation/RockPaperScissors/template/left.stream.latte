{block append}
    <turbo-stream action="append" target="snippet--toasts" data-sender={$sender} data-lang={$lang}>
        <template>
            {capture $message}<b>{$player}</b> {_'game.left'}{/capture}
            {include tRoot('_toast.latte'), type: 'warning', message: $message}</template>
    </turbo-stream>
{/block}

{block update}
    {* the one who stays goes back to waiting (and can play against the computer) *}
    <turbo-stream action="update" target="snippet--opponent" data-sender={$sender} data-lang={$lang}>
        <template>{include '_opponent.latte', state: $state}</template>
    </turbo-stream>
{/block}
