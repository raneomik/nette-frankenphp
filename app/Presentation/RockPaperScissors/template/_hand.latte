{parameters App\Model\RockPaperScissors\Enum\Hand $hand, array $rulesMap}

<template data-tip>
    <div class="text-center p-3">
    <p class="font-bold mb-3">{_"game.hand.{$hand->value}"|firstUpper}</p>
    {foreach $rulesMap as $rule}
        <div n:if="$rule->player === $hand" class="grid grid-cols-3 items-center justify-center-safe">
            {var $textColor = $rule->isAWin() ? 'text-success': 'text-error'}
            {var $verb = 'game.' . ($rule->isAWin() ? 'beats' : 'beatenBy')}
            {var $state = $verb . ".{$rule->player->value}.{$rule->opponent->value}"}
            <span class="text-end {$textColor}">{_"$state.verb"|firstUpper}</span>
            <span class="text-3xl">{$rule->opponent->emoji()}</span>
            <span class="text-start">{_"$state.hand"}</span>
        </div>
    {/foreach}
    </div>
</template>
<span class="hover-3d">
    <span class="text-9xl rounded-4xl h-40 flex items-center">{$hand->emoji()}</span>
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
</span>

