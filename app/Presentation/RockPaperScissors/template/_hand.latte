{parameters App\Model\RockPaperScissors\Enum\Hand $hand, array $rulesMap}

<template data-tip>
    <div class="text-center p-3">
    <p class="font-bold mb-3">{$hand->label()|firstUpper}</p>
    {foreach $rulesMap as $rule}
        <div n:if="$rule->player === $hand" class="grid grid-cols-3 items-center justify-center-safe">
            {var $textColor = $rule->isAWin() ? 'text-success': 'text-error'}
            <span class="text-end {$textColor}">{$rule->game->value}</span>
            <span class="text-3xl">{$rule->opponent->emoji()}</span>
            <span class="text-start">{$rule->opponent->label()}</span>
        </div>
    {/foreach}
    </div>
</template>
<span class="hover-3d">
    <span class="text-9xl rounded-4xl h-42">{$hand->emoji()}</span>
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
</span>

