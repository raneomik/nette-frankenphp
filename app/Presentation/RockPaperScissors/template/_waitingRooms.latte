{* list items only: rendered by the page and by Mercure (waitingRooms.stream.latte), so the <details> around keeps its open state *}
{parameters array $rooms}
{varType App\Model\RockPaperScissors\Value\WaitingRoom $waitingRoom}

<li n:foreach="$rooms as $waitingRoom" class="list-row">
    <a n:href=":RockPaperScissors:Base:game $waitingRoom->id" class="btn w-90">
        Play against {$waitingRoom->lonelyPlayer}
    </a>
</li>
