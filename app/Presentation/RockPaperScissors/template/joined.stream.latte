{block append}
    <turbo-stream action="append" target="snippet--toasts" data-sender={$sender} data-lang={$lang}>
        <template>{capture $message}
                <b>{$player}</b> {_'game.joined'}{/capture}{include tRoot('_toast.latte'), type: 'info', message: $message}
        </template>
    </turbo-stream>
{/block}

{block update}
    <turbo-stream n:ifset="$availableHands" action="update" target="snippet--opponent" data-sender={$sender} data-lang={$lang}>
        <template>{include '_opponent.latte',
            state: $state,
            availableHands: $availableHands
            }</template>
    </turbo-stream>
{/block}
