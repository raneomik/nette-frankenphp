{parameters App\Model\RockPaperScissors\Value\DuelState $state}

{var $outcome = $state->outcome()}
{var $won = $outcome === App\Model\RockPaperScissors\Enum\Result::Win}
{var $lost = $outcome === App\Model\RockPaperScissors\Enum\Result::Lose}

<div class="card-body items-center gap-4" n:attr="data-waiting: (!$state->opponent || $state->solo) ?: null">
    <h2 class="card-title">
        {$state->opponent ?? ('game.waiting'|translate)}
        <span n:if="$state->opponentPlayed" class="badge badge-success">{_'game.ready'}</span>
    </h2>

    <div class="flex h-42 items-center justify-center gap-6 text-8xl">
        {if $state->revealed && $state->mine}
            <span n:class="$lost ? opacity-30" title="{_'game.you'}: {_"game.hand.{$state->mine->value}"}">{$state->mine->emoji()}</span>
            <span class="text-xl font-bold opacity-50">{_'game.vs'}</span>
            <span n:class="$won ? opacity-30" title="{$state->opponent}: {_"game.hand.{$state->revealed->value}"}">{$state->revealed->emoji()}</span>
        {elseif $state->opponent}
            <span title="{_'game.hiddenHand'}">{$state->opponentPlayed ? '❕' : '❓'}</span>
        {else}
            <span class="loading loading-dots loading-lg"></span>
        {/if}
    </div>

    <p n:class="min-h-7, text-lg, font-bold, $won ? text-success : ($lost ? text-error)">
        {if $state->revealed && $state->mine}
            {if !$won && !$lost}
                {_'game.draw'}
            {elseif $won}
                {_'game.win'}
                {var $stateKey = "game.beats.{$state->mine->value}.{$state->revealed->value}"}
                {_"game.hand.{$state->mine->value}"|firstUpper} {_"$stateKey.verb"} {_"$stateKey.hand"}.
                <x-confetti emoji="{$state->mine->emoji()}"></x-confetti>
            {else}
                {* told from the winner's side: "Paper covers rock", not "Rock covered by paper" *}
                {_'game.lose'}
                {var $stateKey = "game.beatenBy.{$state->mine->value}.{$state->revealed->value}"}
                {_"game.hand.{$state->mine->value}"|firstUpper} {_"$stateKey.verb"} {_"$stateKey.hand"}.
            {/if}
        {elseif $state->opponent}
            {$state->opponent} {=($state->opponentPlayed ? 'game.hasPlayed' : 'game.thinking')|translate}
        {/if}
    </p>

    {* 2. nothing else tells that a new round starts just by picking again *}
    <p n:if="$state->revealed && $state->mine && !$state->solo" class="text-sm opacity-60">{_'game.nextRound'}</p>

    <p n:if="!$state->opponent || $state->solo" class="text-sm opacity-60">{_'game.soloHint'}</p>

    <div n:if="$state->opponent && !$state->solo" class="stats bg-base-100">
        <div class="stat place-items-center px-6 py-2">
            <div class="stat-title">{_'game.you'}</div>
            <div class="stat-value text-primary">{$state->myScore}</div>
        </div>
        <div class="stat place-items-center px-6 py-2">
            <div class="stat-title max-w-32">{$state->opponent}</div>
            <div class="stat-value">{$state->theirScore}</div>
        </div>
    </div>
</div>
