{block title}Lobby{/block}

{block content}
    <div class="flex w-full flex-col">

        {include 'template/_handChoice.latte'}

        <div class="divider"></div>

        <div class="mx-auto block">
            <a n:href="Base:game $newRoom" class="btn btn-ghost max-w-lg m-5 text-lg">
                Start a new game
            </a>
        </div>

        {* always rendered, hidden while empty: the live updates (waitingRooms.stream.latte) only replace the <li>s *}
        <details class="collapse collapse-arrow border-base-300 border max-w-100 mx-auto not-has-[li]:hidden">
            <summary class="collapse-title font-semibold">
                Join a waiting player
            </summary>
            <div class="collapse-content flex justify-center">
                <ul id="waiting-room-list" class="list" data-refetch-on-connect>
                    {include 'template/_waitingRooms.latte', rooms: $rooms}
                </ul>
            </div>
        </details>
</div>
{/block}
