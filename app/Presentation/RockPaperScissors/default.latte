{block title}{_'game.lobbyTitle'}{/block}
{block description}{_'game.description'}{/block}

{block content}
    <div class="flex w-full flex-col">

        <h2 class="text-center text-2xl font-extrabold">{_'game.rules'}</h2>
        <p class="mb-2 text-center text-sm opacity-60">{_'game.rulesHint'}</p>
        {include 'template/_handChoice.latte', playable: false}

        <div class="divider"></div>

        <div class="mx-auto block">
            <a n:href="Base:game $newRoom" class="btn btn-primary btn-lg max-w-lg m-5">
                {_'game.newGame'}
            </a>
        </div>

        {* always rendered, hidden while empty: the live updates (waitingRooms.stream.latte) only replace the <li>s *}
        <details class="collapse collapse-arrow border-base-300 border w-full max-w-100 mx-auto not-has-[li]:hidden">
            <summary class="collapse-title font-semibold">
                {_'game.join'}
            </summary>
            <div class="collapse-content flex flex-col gap-2">
                <ul id="waiting-room-list" class="list w-full" data-refetch-on-connect>
                    {include 'template/_waitingRooms.latte', rooms: $rooms}
                </ul>
                {* debug mode only; POST: it changes state for everyone *}
                <form n:if="$debug" method="post" action="{link cleanAll!}" class="px-4">
                    <button type="submit" class="btn btn-dash btn-sm w-full">{_'game.cleanAll'}</button>
                </form>
            </div>
        </details>
</div>
{/block}
