{layout tRoot('@layout.latte')}

{block meta}
    <meta name="user-id" content="{$user->id}">
{/block}

{block navbarContent}
    <div class="navbar-center">
        <span class="text-rotate font-bold text-lg duration-10000">
            <span class="justify-items-center">
                <span>👊 {_'game.hand.rock'|firstUpper}</span>
                <span>{_'game.hand.paper'|firstUpper} ✋</span>
                <span>✌️ {_'game.hand.scissors'|firstUpper}</span>
                <span>{_'game.hand.lizard'|firstUpper} 🤏</span>
                <span>🖖 {_'game.hand.spock'|firstUpper}</span>
            </span>
        </span>
    </div>
{/block}

{block turboLink}
    <div data-turbo-listen="chat">
        <div id="chat" class="toast toast-end">
        </div>
    </div>

    <div data-turbo-listen="player/{$user->id}">
    </div>

    <div data-turbo-listen="room/{$room}">
    </div>
{/block}

