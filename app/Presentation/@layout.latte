<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">
	<link rel="icon" n:asset?="runnerIconAsset()" type="image/x-icon">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Nette Web</title>

	{if hotReloadUrl()}
		<meta name="frankenphp-hot-reload:url" content="{hotReloadUrl()}">
{*		 <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script> - removed, no tracy bar otherwise*}
		<script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
	{/if}

	{asset? app.js}
</head>

<body>

	<div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>

    <div class="w-32">
        <img n:asset="img:mercure" >
    </div>

	{include content}

	<div data-mercure-url="{mercure('test-topic', hub: 'one')}" data-mercure="test-topic">
        Waiting for updates from hub 'one'...
    </div>
	<div class="mercure-container">
        Waiting for updates from hub 'two'...
    </div>
	<div data-turbo-listen="another-test-topic" id="stream-container">
        Waiting for updates from turbo on hub 'one'...
    </div>

    <script type="module">
        const eventSource = new EventSource({mercure('test-topic', hub: 'two', options: [addJwt => true])});

        const containers = document.querySelectorAll('.mercure-container');
        eventSource.onmessage = event => {
            for (const container of containers) {
                container.textContent = event.data;
            }
        }
    </script>

</body>
</html>
