services:
	- App\Core\RouterFactory::createRouter
	- App\Core\Database\SqliteConfigurator

	database.default.connection:
		setup:
			- '$onConnect[]' = [@App\Core\Database\SqliteConfigurator, configure]


search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
			- *Resolver
			- App\Model\Service\**
