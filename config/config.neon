# ======================================
# Config ===============================
php:
	date.timezone: Europe/Prague
	# session.save_path: %tempDir%/session

# ======================================
# Extension ============================

# ======================================
# Services =============================
services:

# see https://doc.nette.org/en/configuring

parameters:


application:
	catchExceptions: '%productionMode%'
	errorPresenter: Nella:Error

	mapping:
		*: 'App\UI\*\**Presenter'
		Nella: 'Contributte\Nella\UI\*Presenter'

di:
	lazy: yes
	export:
		parameters: '%debugMode%'
		tags: '%debugMode%'

http:
	headers:
		X-XSS-Protection: '1; mode=block'
		X-Powered-By: 'contributte'

latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\UI\LatteExtension('%runnerName%')

routing:
	debugger: '%debugMode%'

session:
	debugger: '%debugMode%'
	expiration: '+14 days'
	autoStart: 'smart'

tracy:
	strictMode: yes
	dumpTheme: dark
