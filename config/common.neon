# see https://doc.nette.org/en/configuring
parameters:


application:
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping: App\Presentation\*\**Presenter


di:
    lazy: yes
    export:
        parameters: yes
        tags: '%debugMode%'

database:
    dsn: 'sqlite::memory:'
    user:
    password:


latte:
    strictTypes: yes
    strictParsing: yes
    extensions:
        - App\Presentation\Accessory\LatteExtension(%runner%, %hotReloadUrl%)

extensions:
    mercure: Raneomik\NetteMercure\Bridge\DI\MercureExtension(%debugMode%)

mercure:
    one:
        url: '%baseUrl%/.well-known/mercure'
        jwt:
            key: eyJhbGciOiJIUzI1NiIsInR5cCI6ImF0K2p3dCJ9..iA9iD4tlN8XetNn02eGsgCb8UiPcd8d0RGWZCZUYsnY

        useCookie: no

    two:
        url: '%baseUrl%/.well-known/mercure'
        jwt:
            key: eyJhbGciOiJIUzI1NiIsInR5cCI6ImF0K2p3dCJ9..iA9iD4tlN8XetNn02eGsgCb8UiPcd8d0RGWZCZUYsnY

assets:
    mapping:
        default:
            path: assets
            type: vite  # Uncomment to activate Vite for asset building

        favicon:
            path: assets/favicon
            extension: ico
        img:
            path: assets/img
            extension: [png, jpg, jpeg, gif, svg, webp]

tracy:
    strictMode: yes
    dumpTheme: dark
    bar:
        - App\Core\Tracy\RunnerPanel('%runner%')
        - App\Core\Tracy\PhpInfoPanel
