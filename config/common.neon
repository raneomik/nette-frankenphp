# see https://doc.nette.org/en/configuring
parameters:


application:
    debugger: %debugMode%
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping:
        *: App\Presentation\*\**Presenter
        RockPaperScissors: App\Presentation\RockPaperScissors\*Presenter


di:
    lazy: yes
    export:
        parameters: yes
        tags: '%debugMode%'

http:
    proxy: %trustedProxies%


session:
    savePath: %tempDir%/sessions
    expiration: 30 days


# SQLite file shared by every FrankenPHP thread (":memory:" would give each thread its own empty
# database). var/data is a volume in production: the -wal and -shm files must stay next to it.
database:
    dsn: 'sqlite:%dataDir%/app.db'
    user:
    password:
    options:
        lazy: yes  # connect on first query, once the onConnect hook (services.neon) is set


security:
    authentication:
        storage: session
        expiration: 30 days

latte:
    strictTypes: yes
    strictParsing: yes
    extensions:
        - App\Presentation\Accessory\LatteExtension(%runner%, %hotReloadUrl%)

extensions:
    mercure: Raneomik\NetteMercure\Bridge\DI\MercureExtension(%debugMode%)

mercure:
    one:
        url: '%baseUrl%/.well-known/mercure'
        jwt:
            key: %mercureJwtSecret%

        autoDiscovery: yes

    legacy:
        url: '%baseUrl%/.well-known/mercure'
        jwt:
            key: %mercureJwtSecret%

assets:
    mapping:
        default:
            path: assets
            type: vite  # Uncomment to activate Vite for asset building
        favicon:
            path: assets/favicon
            extension: ico
        img:
            path: assets/img
            extension: [png, jpg, jpeg, gif, svg, webp]

tracy:
    strictMode: yes
    dumpTheme: dark
    bar:
        - App\Core\Tracy\RunnerPanel('%runner%')
        - App\Core\Tracy\PhpInfoPanel
