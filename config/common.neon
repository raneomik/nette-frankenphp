# see https://doc.nette.org/en/configuring
parameters:


extensions:
    mercure: Raneomik\NetteMercure\Bridge\DI\MercureExtension(%debugMode%)
    pwa: Raneomik\NettePWA\Bridge\DI\PWAExtension
    translation: Contributte\Translation\DI\TranslationExtension
    # packages of require-dev: config/dev.neon


application:
    debugger: %debugMode%
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping:
        *: App\Presentation\*\**Presenter
        RockPaperScissors: App\Presentation\RockPaperScissors\*Presenter


di:
    lazy: yes
    export:
        parameters: yes
        tags: '%debugMode%'

http:
    proxy: %trustedProxies%


session:
    savePath: %tempDir%/sessions
    expiration: 30 days


# SQLite file shared by every FrankenPHP thread (":memory:" would give each thread its own empty
# database). var/data is a volume in production: the -wal and -shm files must stay next to it.
database:
    dsn: 'sqlite:%dataDir%/app.db'
    user:
    password:
    options:
        lazy: yes  # connect on first query, once the onConnect hook (services.neon) is set


security:
    authentication:
        storage: session
        expiration: 30 days

latte:
    strictTypes: yes
    strictParsing: yes
    extensions:
        - App\Presentation\Accessory\LatteExtension(%runner%)

translation:
    locales:
        whitelist: [en, fr, cs]
        default: en
        fallback: [en]
    dirs: [%rootDir%/i18n]
    localeResolvers:
        - Contributte\Translation\LocalesResolvers\Router # the URL decides (RouterFactory)
        - Contributte\Translation\LocalesResolvers\Header # no route matched: error pages

mercure:
    url: '%baseUrl%/.well-known/mercure'
    jwt:
        key: %mercureJwtSecret%

    autoDiscovery: yes


# /manifest.webmanifest, /sw.js, /pwa/push/subscribe: POST on, DELETE off, PUT rotation (libs/nette-pwa)
pwa:
    manifest:
        name: frankenette
        shortName: frankenette
        description: 'Nette + FrankenPHP + Mercure: rock paper scissors'
        backgroundColor: '#11161c'
        themeColor: '#11161c'
        icons:  # make pwa-icon
            - {src: 'img:pwa-icon', sizes: any, type: image/svg+xml, purpose: any}
            - {src: 'img:pwa-icon', sizes: any, type: image/svg+xml, purpose: maskable}
    push:
        vapid:  # empty (Bootstrap: VAPID_* env) = push off, the opt-in button stays hidden
            publicKey: %vapidPublicKey%
            privateKey: %vapidPrivateKey%
        ttl: 600  # "X joined" is worthless after 10 minutes

assets:
    mapping:
        default:
            path: assets
            type: vite  # Uncomment to activate Vite for asset building
        favicon:
            path: assets/favicon
            extension: ico
        img:
            path: assets/img
            extension: [png, jpg, jpeg, gif, svg, webp]

tracy:
    strictMode: yes
    bar:
        - App\Core\Tracy\RunnerPanel('%runner%')
        - App\Core\Tracy\PhpInfoPanel
