#!/bin/bash

#
# Cleanup certificates from local system (linux)
#
local_certs_remove() {
	log "🧹 Starting Certificate cleanup" ${BLUE}
	if [ -f  $LOCAL_CERT_PATH ]; then
		sudo rm $LOCAL_CERT_PATH
		sudo update-ca-certificates --fresh 1> /dev/null 2>&1
		log "✔️ Removed system certificates. ($LOCAL_CERT_PATH)" ${BLUE}
	else
		log "⚠️ Certificate file not found: $LOCAL_CERT_PATH. No cleanup needed" ${YELLOW}
	fi
}

#
# Cleanup windows certificates
#
win_certs_remove() {
	log "🧹 Windows Certificates cleanup...(a prompt may appear and needs to be accepted)" ${BLUE}

    win_certs_check

	if [ $installed_certs -lt 0 ]; then
        log "ℹ️ No Caddy Local Authority certificates found in Windows. No cleanup needed" ${YELLOW}
        return
    fi

	powershell.exe -Command "
		Start-Process powershell -Verb RunAs -ArgumentList '-Command', '
			Get-ChildItem Cert:\LocalMachine\Root |
			Where-Object { \$_.Subject -like ''*Caddy Local Authority*'' } |
			Remove-Item -Force;
			Write-Host \"Removing Certificates ...\" -ForegroundColor Green;
			pause
		'
		" 2>/dev/null

	win_cert_dir="/mnt/c/Users/$USER/frankenphp-certs"
	if [ -d "$win_cert_dir" ]; then
		rm -rf "$win_cert_dir"
		log "✔️ Removed certificate directory: $win_cert_dir"
	fi

	log "✔️ Removed Windows certificates" ${GREEN}
}

certs_remove() {
	case "$MODE" in
	win)
		win_certs_remove
		;;
	local)
		local_certs_remove
		;;
	all)
        log "ℹ️(repetitions may occur. Please, don't mind 'em)" ${BLUE}
		local_certs_remove
		win_certs_remove
		;;
	*)
		log "⚠️ Please specify a mode: --win, --local or --all" ${YELLOW}
	esac
}
