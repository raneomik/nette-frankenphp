#!/bin/bash


# GLOBALS
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

PHP_INI="(none)"
CONTAINER_NAME=""
LOCAL_CERT_PATH="/usr/local/share/ca-certificates/caddy-local-authority.crt"
FRANKEN_CERT_PATH="/data/caddy/pki/authorities/local/root.crt"


SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CERTS_DIR="$SCRIPT_DIR/_certs"

source "$SCRIPT_DIR/_certs/_check_expired"
source "$SCRIPT_DIR/_certs/_check_sync"
source "$SCRIPT_DIR/_certs/_check"
source "$SCRIPT_DIR/_certs/_install"
source "$SCRIPT_DIR/_certs/_remove"


# (internal) Log with color
log() {
	echo -e "${2}$1${NC}"
}

# (internal) Get FrankenPHP container name
load_frankenphp_dc_name() {
	CONTAINER_NAME=$(docker ps --format "{{.Names}}" | grep frankenphp | head -n 1)

	if [ -z "$CONTAINER_NAME" ]; then
		log "⚠️ FrankenPHP container not running. Please, start it first." ${YELLOW}
		exit 1
	fi

	log "📦 Found FrankenPHP docker container: $CONTAINER_NAME"
	log "⏳  Checking Caddy/FrankenPHP certificate..."
	for i in {1..10}; do
		if docker exec $CONTAINER_NAME test -f $FRANKEN_CERT_PATH 2>/dev/null; then
			log "✔️ Caddy/FrankenPHP certificate is available."
			break
		fi
		sleep 0.5
		echo -n "."
	done
}

extract_cert_from_container () {
	local cert_path="$1"

	docker exec $CONTAINER_NAME cat $FRANKEN_CERT_PATH | sudo tee "$cert_path" > /dev/null 2>&1
}

usage() {
	log "Install FrankenPHP certificates on Linux/WSL for Windows"
	log "Usage: $0 {install|remove|check} [--win|--php|--local]"
	log ""
	log "Actions:"
	log "  install      Install certificates"
	log "  remove       Remove certificates"
	log "  check        Check if certificates are installed"
	log "  init         install all"
	log ""
	log "Modes:"
	log "  --local      Operate on local system certificates (Linux)"
	log "  --php        Operate on local PHP certificates (Linux)"
	log "  --win        Operate on Windows certificates (WSL)"
	log "  --all        Operate on all systems linux/wsl and Windows- "
	log ""
	exit 1
}

ACTION=""
MODE=""

while [ $# -gt 0 ]; do
  case "$1" in
    install)
      ACTION="install"
      ;;
    remove)
      ACTION="remove"
      ;;
    check)
      ACTION="check"
      ;;
    init)
      ACTION="init"
      ;;
    --win)
      MODE="win"
      ;;
    --php)
      MODE="php"
      ;;
    --local)
      MODE="local"
      ;;
    --all)
      MODE="all"
      ;;
  esac
  shift
done

export MODE

case "$ACTION" in
	install)
		certs_install
		;;
	remove)
		certs_remove
		;;
	check)
		certs_check
		;;
	*)
		usage
		;;
esac
