{
  "name": "raneomik/nette-frankenphp",
  "description": "Nette + FrankenPHP + Mercure ",
  "keywords": [
    "nette",
    "frankenphp",
    "mercure"
  ],
  "type": "project",
  "license": [
    "MIT",
    "BSD-3-Clause",
    "GPL-2.0-only",
    "GPL-3.0-only"
  ],
  "require": {
    "php": "8.4 - 8.5",
    "nette/application": "^3.3",
    "nette/assets": "^1.0",
    "nette/bootstrap": "^3.3",
    "nette/caching": "^3.4",
    "nette/database": "^3.2",
    "nette/di": "^3.2",
    "nette/forms": "^3.3",
    "nette/http": "^3.3",
    "nette/mail": "^4.0",
    "nette/robot-loader": "^4.0",
    "nette/security": "^3.2",
    "nette/utils": "^4.0",
    "latte/latte": "^3.0",
    "tracy/tracy": "^2.10",
    "raneomik/nette-mercure": "dev-main",
    "navisborealis/wonderwords-php": "^1.4",
    "fakerphp/faker": "^1.24",
    "minishlink/web-push": "^11.0",
    "nyholm/psr7": "^1.8",
    "raneomik/nette-pwa": "dev-main",
    "raneomik/tracy-dark-mode": "dev-main"
  },
  "require-dev": {
    "nette/tester": "^2.5",
    "phpstan/phpstan-nette": "^2",
    "symfony/thanks": "^1",
    "symplify/easy-coding-standard": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    }
  },
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "symfony/thanks": true,
      "php-http/discovery": true
    }
  }
}
