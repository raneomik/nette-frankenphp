{
  "name": "contributte/demo-frankenphp",
  "description": "Nette + FrankenPHP by Felix",
  "keywords": [
    "nette",
    "frankenphp"
  ],
  "type": "project",
  "license": [
    "MIT",
    "BSD-3-Clause",
    "GPL-2.0-only",
    "GPL-3.0-only"
  ],
  "repositories": [
    {
      "type": "path",
      "url": "libs/nette-tracy-dark-mode",
      "only": [
        "nette/tracy-dark-mode"
      ],
      "options": {
        "versions": {
          "nette/tracy-dark-mode": "1.0.0"
        }
      }
    }
  ],
  "require": {
    "php": ">= 8.2",
    "nette/application": "^3.2.3",
    "nette/assets": "^1.0.0",
    "nette/bootstrap": "^3.2.6",
    "nette/caching": "^3.2",
    "nette/database": "^3.2",
    "nette/di": "^3.2",
    "nette/forms": "^3.2",
    "nette/http": "^3.3",
    "nette/mail": "^4.0",
    "nette/robot-loader": "^4.0",
    "nette/security": "^3.2",
    "nette/utils": "^4.0",
    "latte/latte": "^3.0",
    "tracy/tracy": "^2.10",
    "lcobucci/jwt": "6.0.x-dev",
    "raneomik/nette-mercure": "dev-main"
  },
  "require-dev": {
    "nette/tester": "^2.5",
    "phpstan/phpstan-nette": "^2",
    "symfony/thanks": "^1",
    "nette/tracy-dark-mode": "^1",
    "symplify/easy-coding-standard": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    }
  },
  "minimum-stability": "dev",
  "scripts": {
    "phpstan": "phpstan analyse",
    "tester": "tester tests -s"
  },
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "symfony/thanks": true
    }
  }
}
