    lizard: ještěr
    spock: Spock

# tooltip grid, <my hand>.<other hand>: verb and noun both change with the pair (cs: tupí nůžky / drtí ještěra)
beats:
    rock:
        scissors: {verb: "tupí", hand: "nůžky"}
        lizard: {verb: "drtí", hand: "ještěra"}
    paper:
        rock: {verb: "balí", hand: "kámen"}
        spock: {verb: "usvědčuje", hand: "Spocka"}
    scissors:
        paper: {verb: "stříhají", hand: "papír"}
        lizard: {verb: "stínají hlavu", hand: "ještěrovi"}
    lizard:
        paper: {verb: "žere", hand: "papír"}
        spock: {verb: "tráví", hand: "Spocka"}
    spock:
        scissors: {verb: "rozbíjí", hand: "nůžky"}
        rock: {verb: "vypaří", hand: "kámen"}

beatenBy:
    rock:
        paper: {verb: "zabalen", hand: "papírem"}
        spock: {verb: "vypařen", hand: "Spockem"}
    paper:
        scissors: {verb: "rozstříhán", hand: "nůžkami"}
        lizard: {verb: "sežrán", hand: "ještěrem"}
    scissors:
        rock: {verb: "ztupené", hand: "kamenem"}
        spock: {verb: "rozbité", hand: "Spockem"}
    lizard:
        rock: {verb: "rozdrcen", hand: "kamenem"}
        scissors: {verb: "sťat", hand: "nůžkami"}
    spock:
        paper: {verb: "usvědčen", hand: "papírem"}
        lizard: {verb: "otráven", hand: "ještěrem"}

