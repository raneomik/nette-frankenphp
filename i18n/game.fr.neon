title: Pierre Papier Ciseaux
description: "Jouez à Pierre Papier Ciseaux Lézard Spock en ligne, contre un ami ou contre l'ordinateur."
lobbyTitle: Pierre Papier Ciseaux - Salon
you: Vous
vs: VS
computer: Ordinateur

hand:
    rock: pierre
    paper: papier
    scissors: ciseaux
    lizard: lézard
    spock: Spock

# tooltip grid, <my hand>.<other hand>: verb and noun both change with the pair (cs: tupí nůžky / drtí ještěra)
beats:
    rock:
        scissors: {verb: "écrase", hand: "les ciseaux"}
        lizard: {verb: "écrase", hand: "le lézard"}
    paper:
        rock: {verb: "recouvre", hand: "la pierre"}
        spock: {verb: "réfute", hand: "Spock"}
    scissors:
        paper: {verb: "coupent", hand: "le papier"}
        lizard: {verb: "décapitent", hand: "le lézard"}
    lizard:
        paper: {verb: "mange", hand: "le papier"}
        spock: {verb: "empoisonne", hand: "Spock"}
    spock:
        scissors: {verb: "écrabouille", hand: "les ciseaux"}
        rock: {verb: "vaporise", hand: "la pierre"}
beatenBy:
    rock:
        paper: {verb: "recouverte par", hand: "le papier"}
        spock: {verb: "vaporisée par", hand: "Spock"}
    paper:
        scissors: {verb: "découpé par", hand: "les ciseaux"}
        lizard: {verb: "mangé par", hand: "le lézard"}
    scissors:
        rock: {verb: "écrasés par", hand: "la pierre"}
        spock: {verb: "écrabouillés par", hand: "Spock"}
    lizard:
        rock: {verb: "écrasé par", hand: "la pierre"}
        scissors: {verb: "décapité par", hand: "les ciseaux"}
    spock:
        paper: {verb: "réfuté par", hand: "le papier"}
        lizard: {verb: "empoisonné par", hand: "le lézard"}

