{
  "name": "nette/mercure",
  "description": "Nette Mercure Extension",
  "keywords": [
    "mercure",
    "push",
    "sse",
    "updates"
  ],
  "homepage": "https://nette.org",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "nette/http": "^2.0|^3.3",
    "symfony/mercure": "^0.7.2"
  },
  "require-dev": {
    "latte/latte": "^2.0|^3.0",
    "nette/di": "^3.0",
    "nette/tester": "^2.5",
    "nette/security": "^3.0",
    "tracy/tracy": "^2.8",
    "phpstan/phpstan-nette": "^2.0@stable"
  },
  "autoload": {
    "psr-4": {
      "Nette\\Mercure\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "extra": {
    "nette": {
      "di-extensions": {
        "mercure": {
          "args": [
            "%debugMode%"
          ],
          "class": "Nette\\Mercure\\DI\\MercureExtension"
        }
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}
