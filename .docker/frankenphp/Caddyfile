{
	{$CADDY_GLOBAL_OPTIONS}

	order php_server before file_server
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {

    handle /.well-known/mercure* {
        mercure {
			{$MERCURE_EXTRA_DIRECTIVES}
            cors_origins * # needed for cross-server communication (dev tests)
            anonymous # needed for hot-reload
			publisher_jwt {$MERCURE_JWT_SECRET} {env.MERCURE_PUBLISHER_JWT_ALG}
			subscriber_jwt {$MERCURE_JWT_SECRET} {env.MERCURE_SUBSCRIBER_JWT_ALG}
        }
    }

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	handle {
		root * /srv/www/

		@indexFiles file {
			try_files {path} index.php
			split_path .php
		}
		rewrite @indexFiles {http.matchers.file.relative}

		encode zstd br gzip

		php_server {$FRANKENPHP_CONFIG}
	}
}
