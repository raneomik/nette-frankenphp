{
    metrics
    {$CADDY_GLOBAL_OPTIONS}
}

# Prometheus scrap (inside docker only)
:9180 {
    metrics
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
    log {
        {$CADDY_SERVER_LOG_OPTIONS}
        # Redact the authorization query parameter that can be set by Mercure
        format filter {
            request>uri query {
                replace authorization REDACTED
            }
        }
    }

    root /srv/www
    encode zstd br gzip

    mercure {
        # must match the JWT "iss" claim (= https://<public domain>), regardless
        # of SERVER_NAME, which is ":80" behind a reverse proxy
        issuer {$MERCURE_ISSUER:https://localhost} {
            # one secret for both: the app signs publisher AND subscriber tokens with it
            # (nette-mercure: one jwt.key per hub, see config/common.neon)
            publisher {
                jwt {env.MERCURE_JWT_SECRET}
            }

            subscriber {
                jwt {env.MERCURE_JWT_SECRET}
            }
        }

        {$MERCURE_EXTRA_DIRECTIVES}
   }

    vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

    @phpRoute {
        not path /.well-known/mercure*
        not file {path}
    }
    rewrite @phpRoute index.php

    @frontController path index.php
    php @frontController {
        {$FRANKENPHP_SITE_CONFIG}
    }

    # every URL under /assets changes with its content (Vite hash, or ?v=<mtime> from Nette Assets):
    # never revalidate. A file linked there without n:asset / {asset} would stay stale for a year.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    file_server {
        hide *.php
    }
}
