{
    metrics
    {$CADDY_GLOBAL_OPTIONS}
}

# Prometheus scrap (inside docker only)
:9180 {
    metrics
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
    log {
        {$CADDY_SERVER_LOG_OPTIONS}
        # Redact the authorization query parameter that can be set by Mercure
        format filter {
            request>uri query {
                replace authorization REDACTED
            }
        }
    }

    root /srv/www
    encode zstd br gzip

    # security headers (HSTS is set on the edge Caddy only, see .docker/deploy/compose.yaml:
    # on https://localhost it would stick to every local project)
    header {
        -Server
        X-Content-Type-Options nosniff
        # CSP below starts in Report-Only, where frame-ancestors is not enforced: this one is
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy same-origin
        # Report-Only first (violations in the browser console): once clean, set
        # CSP_HEADER=Content-Security-Policy to enforce it, no rebuild needed.
        # sha256: the theme script inlined in app/Presentation/@layout.latte (recompute if it changes:
        # printf '%s' "<script body>" | openssl dgst -sha256 -binary | base64)
        {$CSP_HEADER:Content-Security-Policy-Report-Only} "default-src 'self'; script-src 'self' 'sha256-lPKygQAghhlzI+DppV06MjI5u6ZtDM6HKHlcWxeHWXU='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }

    mercure {
        # must match the JWT "iss" claim (= https://<public domain>), regardless
        # of SERVER_NAME, which is ":80" behind a reverse proxy
        issuer {$MERCURE_ISSUER:https://localhost} {
            # one secret for both: the app signs publisher AND subscriber tokens with it
            # (nette-mercure: one jwt.key per hub, see config/common.neon)
            publisher {
                jwt {env.MERCURE_JWT_SECRET}
            }

            subscriber {
                jwt {env.MERCURE_JWT_SECRET}
            }
        }

        {$MERCURE_EXTRA_DIRECTIVES}
   }

    vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

    @phpRoute {
        not path /.well-known/mercure*
        not file {path}
    }
    rewrite @phpRoute index.php

    @frontController path index.php
    php @frontController {
        {$FRANKENPHP_SITE_CONFIG}
    }

    # every URL under /assets changes with its content (Vite hash, or ?v=<mtime> from Nette Assets):
    # never revalidate. A file linked there without n:asset / {asset} would stay stale for a year.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    file_server {
        hide *.php
    }
}
