{
  "uid": "frankenphp",
  "title": "FrankenPHP",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Threads PHP",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(frankenphp_busy_workers)",
          "legendFormat": "busy workers"
        },
        {
          "refId": "B",
          "expr": "sum(frankenphp_total_workers)",
          "legendFormat": "total workers"
        },
        {
          "refId": "C",
          "expr": "sum(frankenphp_ready_workers)",
          "legendFormat": "ready workers"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue (saturation)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(frankenphp_worker_queue_depth) or vector(0)",
          "legendFormat": "queued (worker)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker restarts / min",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(frankenphp_worker_restarts[1m])) * 60",
          "legendFormat": "restarts/min"
        }
      ]
    }
  ]
}
