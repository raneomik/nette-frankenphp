# /srv/rpsls/litestream.env — sur le VPS (chmod 600), jamais commité.
# Sans ce fichier, deploy.sh ne lance pas litestream (et prévient que la base n'est pas sauvegardée).
# Où répliquer la base : un stockage hors du VPS, sinon ce n'est pas une sauvegarde.
# Pas besoin d'AWS : n'importe quel stockage compatible S3, ou SFTP.

# Backblaze B2 (10 Go gratuits, envois gratuits) : bucket privé + "Application Key"
# limitée à ce bucket ; l'endpoint est affiché sur la page du bucket.
LITESTREAM_REPLICA_URL=s3://mon-bucket/rpsls/app.db?endpoint=s3.eu-central-003.backblazeb2.com
LITESTREAM_ACCESS_KEY_ID=change-me
LITESTREAM_SECRET_ACCESS_KEY=change-me

# Cloudflare R2 (10 Go gratuits) : endpoint = <account id>.r2.cloudflarestorage.com, region=auto
#   s3://mon-bucket/rpsls/app.db?endpoint=<account-id>.r2.cloudflarestorage.com&region=auto

# SFTP, sans aucun compte cloud : une machine à toi joignable en SSH (NAS, autre serveur…).
# Retire les 2 clés ci-dessus ; la clé privée est montée dans le conteneur (cf. README).
#   LITESTREAM_REPLICA_URL=sftp://backup@nas.example.fr:22/backups/rpsls

# Pour essayer seulement, sur le VPS lui-même (pas une vraie sauvegarde) :
#   LITESTREAM_REPLICA_URL=file:///data/replica
