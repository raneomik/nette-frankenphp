# litestream.env — on the VPS, in the project folder (chmod 600), never committed.
# Without this file, deploy.sh does not start litestream (and warns that the database is not backed up).
# Where to replicate the database: a storage off the VPS, otherwise it is not a backup.
# No need for AWS: any S3-compatible storage, or SFTP.

# Backblaze B2 (10 GB free, free uploads): private bucket + "Application Key"
# restricted to that bucket; the endpoint is shown on the bucket page.
LITESTREAM_REPLICA_URL=s3://my-bucket/rpsls/app.db?endpoint=s3.eu-central-003.backblazeb2.com
LITESTREAM_ACCESS_KEY_ID=change-me
LITESTREAM_SECRET_ACCESS_KEY=change-me

# Cloudflare R2 (10 GB free): endpoint = <account id>.r2.cloudflarestorage.com, region=auto
#   s3://my-bucket/rpsls/app.db?endpoint=<account-id>.r2.cloudflarestorage.com&region=auto

# SFTP, with no cloud account at all: a machine of yours reachable over SSH (NAS, another server…).
# Remove the 2 keys above; the private key is mounted in the container (see README).
#   LITESTREAM_REPLICA_URL=sftp://backup@nas.example.fr:22/backups/rpsls

# Just to try it out, on the VPS itself (not a real backup):
#   LITESTREAM_REPLICA_URL=file:///data/replica
