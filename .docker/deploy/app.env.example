# /srv/rpsls/app.env — sur le VPS (chmod 600), jamais commité
# Génère un secret neuf : openssl rand -base64 48
# (celui du dépôt est public : n'importe qui pourrait publier sur le hub)
MERCURE_PUBLISHER_JWT_KEY=change-me
MERCURE_SUBSCRIBER_JWT_KEY=change-me

# Sous-réseau(x) du réseau docker "caddy", séparés par des virgules :
#   docker network inspect caddy -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.16.0.0/12
