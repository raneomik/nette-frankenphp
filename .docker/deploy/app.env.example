# app.env — on the VPS, in the project folder (chmod 600), never committed
# Mercure hub JWT secret (at least 32 characters): the app signs publisher and subscriber
# tokens with it, the hub checks both with it. Without it the container does not start.
# A fresh value (the one in the repository is public):
#   sed -i "s#^MERCURE_JWT_SECRET=.*#MERCURE_JWT_SECRET=$(openssl rand -base64 48)#" app.env
MERCURE_JWT_SECRET=change-me

# Subnet(s) of the "caddy" docker network, comma-separated:
#   docker network inspect caddy -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.16.0.0/12

# Web Push ("X joined your room" notifications), optional: off while empty. A fresh pair:
#   docker compose exec app php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# Changing them invalidates every stored browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
