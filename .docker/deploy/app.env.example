# /srv/rpsls/app.env — on the VPS (chmod 600), never committed
# Generate a fresh secret: openssl rand -base64 48
# (the one in the repository is public: anyone could publish on the hub)
MERCURE_PUBLISHER_JWT_KEY=change-me
MERCURE_SUBSCRIBER_JWT_KEY=change-me

# Subnet(s) of the "caddy" docker network, comma-separated:
#   docker network inspect caddy -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.16.0.0/12
